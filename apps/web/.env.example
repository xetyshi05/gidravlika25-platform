# Deployment stage used by fail-fast validation: development, test, staging or production.
APP_ENV=development

# Private API URL used by server components. In containers this is normally the API service name.
API_URL=http://localhost:4000

# Public browser key for Yandex Maps JavaScript API v3.
# Restrict this key by HTTP Referer in the Yandex developer dashboard.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Public URL used by browser forms to send requests to the API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public website origin used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://gidravlika25.ru

# Public base URL of the S3 bucket/CDN that serves site images.
S3_PUBLIC_URL=https://cdn.gidravlika25.ru
S3_ALLOW_LOCAL_IP=false

# Optional comma-separated hosts that may access the Next.js development server.
NEXT_ALLOWED_DEV_ORIGINS=

# Shared with the API. Use a random value with at least 32 characters in deployment.
CATALOG_REVALIDATION_SECRET=replace-with-a-shared-secret-at-least-32-characters
