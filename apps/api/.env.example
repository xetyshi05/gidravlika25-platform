NODE_ENV=development
# Set to production or staging to enable strict deployment validation independently of tooling.
APP_ENV=development
DATABASE_URL=postgresql://gidravlika:change-me@localhost:5432/gidravlika?schema=public
PORT=4000
# Structured logger threshold: debug, info, warn, error or fatal.
LOG_LEVEL=debug
# Development/testing only: accepts the configured code instead of a TOTP code.
# The API refuses to start with mock mode in staging or production.
TWO_FACTOR_MODE=totp
# TWO_FACTOR_MOCK_CODE=000000
# Required in production. Use a random value with at least 32 characters.
BOOTSTRAP_SECRET=
DADATA_API_KEY=
# Timeout for the DaData HTTP request.
DADATA_REQUEST_TIMEOUT_MS=5000
WEB_ORIGIN=http://localhost:3000
# Public request protection. Defaults: 10 requests per 60000 ms for each client IP.
PUBLIC_REQUEST_RATE_LIMIT_MAX=10
PUBLIC_REQUEST_RATE_LIMIT_WINDOW_MS=60000
# ALTCHA challenges of the public forms. Optional in development (a random
# secret per process is used), required in production (32+ characters).
ALTCHA_HMAC_SECRET=
# Set this to the number of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=0
# Calendar minutes before a new CRM request is considered overdue.
REQUEST_FIRST_RESPONSE_MINUTES=60
# Active legal document accepted by public request endpoints.
PERSONAL_DATA_DOCUMENT_VERSION=2026-09-08
PERSONAL_DATA_DOCUMENT_HASH=7a4ac553b3b5f4f7fbaee6018215e87d1883598727cbd555123a2227c0fb48ea
PERSONAL_DATA_RETENTION_ENABLED=false
PERSONAL_DATA_RETENTION_DAYS=1095
PERSONAL_DATA_RETENTION_INTERVAL_HOURS=24
PERSONAL_DATA_RETENTION_BATCH_SIZE=100
PERSONAL_DATA_RETENTION_DRY_RUN=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=gidravlika-catalog
S3_ACCESS_KEY_ID=gidravlika-local
S3_SECRET_ACCESS_KEY=gidravlika-local-password
S3_PUBLIC_URL=http://localhost:9000/gidravlika-catalog
# Timeout for each S3 SDK request.
S3_REQUEST_TIMEOUT_MS=15000
# Kept off the public web server. In production this must be a persistent mounted directory.
MEDIA_ORIGINALS_DIR=.local/media/originals
# Retries deletions of files queued in StorageCleanup (S3-01).
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_INTERVAL_MINUTES=15
# Deletes unreferenced generated files from S3 and MEDIA_ORIGINALS_DIR. Keep it off
# unless this database is the only one that uses the bucket (never against production S3).
MEDIA_RECONCILE_ENABLED=false
MEDIA_RECONCILE_DRY_RUN=true
MEDIA_RECONCILE_INTERVAL_HOURS=24
MEDIA_RECONCILE_GRACE_HOURS=24
# The local rembg worker is available after `docker compose up -d`.
BACKGROUND_REMOVAL_URL=http://localhost:8001

# Optional in development. Production uses the internal Web container URL.
CATALOG_REVALIDATION_URL=http://localhost:3000/api/revalidate-catalog
CATALOG_REVALIDATION_SECRET=replace-with-a-shared-secret-at-least-32-characters
CATALOG_REVALIDATION_TIMEOUT_MS=5000
# A persistent random value used to encrypt authenticator-app secrets at rest.
TOTP_ENCRYPTION_KEY=
