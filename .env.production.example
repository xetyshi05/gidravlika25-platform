# Copy this file to .env.production on the server and set mode 600.
# Never commit the populated file.
IMAGE_TAG=replace-with-git-commit
CONTAINER_IMAGE_PREFIX=gidravlika25

# Public hosts and origins. Keep WEB_ORIGIN comma-separated and without paths.
# Only the public site calls the API from the browser; CRM and Back Office use
# API_URL inside the Docker network, so their origins are not listed.
SITE_HOST=gidravlika25.ru
SITE_WWW_HOST=www.gidravlika25.ru
API_HOST=api.gidravlika25.ru
CRM_HOST=crm.gidravlika25.ru
BACKOFFICE_HOST=bo.gidravlika25.ru
TLS_CERT_NAME=gidravlika25.ru
WEB_ORIGIN=https://gidravlika25.ru,https://www.gidravlika25.ru
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=https://api.gidravlika25.ru
NEXT_PUBLIC_SITE_URL=https://gidravlika25.ru
BACKOFFICE_ORIGIN=https://bo.gidravlika25.ru
TRUST_PROXY_HOPS=1

POSTGRES_DB=gidravlika
# Superuser: used only by PostgreSQL itself, the db-roles job and backups.
POSTGRES_USER=gidravlika
POSTGRES_PASSWORD=
# Passwords of the migrator and app_runtime roles (created by the db-roles job).
# At least 32 characters of A-Z, a-z, 0-9, "_" or "-"; the API and migration
# connection URLs are built from them in compose.production.yml.
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_PASSWORD=

BOOTSTRAP_SECRET=
TOTP_ENCRYPTION_KEY=
# Signs the ALTCHA challenges of the public forms (at least 32 random characters).
ALTCHA_HMAC_SECRET=
# Bearer token of GET https://<API_HOST>/ops/status for the production monitor
# (REL-03), at least 32 random characters; the same value goes into the GitHub
# secret OPS_STATUS_TOKEN.
OPS_STATUS_TOKEN=
# DaData calls per day (Moscow time) shared by all API replicas; the free plan has 10 000.
DADATA_DAILY_LIMIT=9000
# Alert thresholds of /ops/status: 5xx responses and p95 latency over 15 minutes,
# age of the last successful backup.
OPS_ALERT_SERVER_ERRORS=5
OPS_ALERT_P95_MS=2500
OPS_BACKUP_MAX_AGE_HOURS=26
LOG_LEVEL=info
PUBLIC_REQUEST_RATE_LIMIT_MAX=10
PUBLIC_REQUEST_RATE_LIMIT_WINDOW_MS=60000
# Anti-spam budgets that do not depend on the IP address (SEC-03).
PUBLIC_REQUEST_CONTACT_LIMIT_MAX=5
PUBLIC_REQUEST_CONTACT_LIMIT_WINDOW_MS=3600000
PUBLIC_REQUEST_GLOBAL_LIMIT_MAX=200
PUBLIC_REQUEST_GLOBAL_LIMIT_WINDOW_MS=3600000
# Proof-of-work difficulty: PBKDF2 iterations per attempt and attempts range.
ALTCHA_COST=1000
ALTCHA_MAX_COUNTER=10000
ALTCHA_EXPIRES_SECONDS=1200
REQUEST_FIRST_RESPONSE_MINUTES=60
PERSONAL_DATA_DOCUMENT_VERSION=2026-09-08
PERSONAL_DATA_DOCUMENT_HASH=7a4ac553b3b5f4f7fbaee6018215e87d1883598727cbd555123a2227c0fb48ea
PERSONAL_DATA_RETENTION_ENABLED=true
PERSONAL_DATA_RETENTION_DAYS=1095
PERSONAL_DATA_RETENTION_INTERVAL_HOURS=24
PERSONAL_DATA_RETENTION_BATCH_SIZE=100
# Set true for an observation-only rollout; eligible totals are written to structured logs.
PERSONAL_DATA_RETENTION_DRY_RUN=false

DADATA_API_KEY=
DADATA_REQUEST_TIMEOUT_MS=5000

S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_REQUEST_TIMEOUT_MS=15000
# Mount this private directory into the API container; do not serve it via nginx.
MEDIA_ORIGINALS_DIR=/var/lib/gidravlika-media/originals
# Queued deletions of replaced and deleted files are retried every N minutes (S3-01).
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_INTERVAL_MINUTES=15
# Daily reconciliation of S3 and MEDIA_ORIGINALS_DIR with the database. It only
# deletes unreferenced files with API-generated <uuid> keys older than the grace
# period. Starts as a report: check `media.storage_reconciled` in the API log
# (no other database, e.g. a local dev stack, may use this bucket), then set false.
MEDIA_RECONCILE_ENABLED=true
MEDIA_RECONCILE_DRY_RUN=true
MEDIA_RECONCILE_INTERVAL_HOURS=24
MEDIA_RECONCILE_GRACE_HOURS=24
# Internal address of the rembg worker. It must not be exposed publicly.
BACKGROUND_REMOVAL_URL=http://image-worker:8000
# The background-removal model is loaded once and can require noticeable RAM.
IMAGE_WORKER_CPUS=1
IMAGE_WORKER_MEMORY_LIMIT=1536m
S3_ALLOW_LOCAL_IP=false

# Shared by API and Web to invalidate cached catalog responses after changes.
CATALOG_REVALIDATION_SECRET=
CATALOG_REVALIDATION_TIMEOUT_MS=5000
CATALOG_REVALIDATION_URL=http://web:3000/api/revalidate-catalog

NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
VERIFY_BACKUP_RESTORE=true
# Optional off-site copy (owner decision D5: disabled for now). When set,
# every deploy requires a successful upload, and everything is encrypted with
# age to BACKUP_AGE_RECIPIENT (public key; the owner keeps the private key).
# Use a separate private bucket and a key that may only upload (PutObject);
# set a lifecycle rule on the db/ prefix equal to BACKUP_RETENTION_DAYS.
BACKUP_S3_URI=
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-central1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

CERTBOT_EMAIL=

# Container resource and local log retention policy.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
POSTGRES_CPUS=2
POSTGRES_MEMORY_LIMIT=1536m
API_CPUS=1.5
API_MEMORY_LIMIT=1024m
WEB_CPUS=1
WEB_MEMORY_LIMIT=768m
CRM_CPUS=0.75
CRM_MEMORY_LIMIT=512m
BACKOFFICE_CPUS=0.75
BACKOFFICE_MEMORY_LIMIT=512m
NGINX_CPUS=0.5
NGINX_MEMORY_LIMIT=256m
CERTBOT_CPUS=0.5
CERTBOT_MEMORY_LIMIT=256m
BACKUP_CPUS=1
BACKUP_MEMORY_LIMIT=768m
