{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["apps/api/**/*.ts", "apps/api/**/*.js"],
      "options": {
        "singleQuote": true
      }
    }
  ]
}
