# Test-only values for building and smoke-testing the production images in CI
# (deploy/scripts/test-production-images.sh). Nothing here is a real secret;
# never use this file for a deployment.
IMAGE_TAG=local
CONTAINER_IMAGE_PREFIX=gidravlika25-ci

SITE_HOST=site.example.test
SITE_WWW_HOST=www.site.example.test
API_HOST=api.example.test
CRM_HOST=crm.example.test
BACKOFFICE_HOST=admin.example.test
TLS_CERT_NAME=site.example.test
WEB_ORIGIN=https://site.example.test
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=https://api.example.test
NEXT_PUBLIC_SITE_URL=https://site.example.test
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
BACKOFFICE_ORIGIN=https://admin.example.test
TRUST_PROXY_HOPS=1

POSTGRES_DB=gidravlika
POSTGRES_USER=gidravlika
POSTGRES_PASSWORD=ci-only-superuser-password-000000000000
DB_MIGRATOR_PASSWORD=ci-only-migrator-password-0000000000000
DB_RUNTIME_PASSWORD=ci-only-runtime-password-00000000000000

BOOTSTRAP_SECRET=ci-only-bootstrap-secret-000000000000000
TOTP_ENCRYPTION_KEY=ci-only-totp-encryption-key-000000000000
CATALOG_REVALIDATION_SECRET=ci-only-revalidation-secret-00000000000
ALTCHA_HMAC_SECRET=ci-only-altcha-hmac-secret-000000000000
OPS_STATUS_TOKEN=ci-only-ops-status-token-00000000000000
PERSONAL_DATA_DOCUMENT_VERSION=2026-09-08
PERSONAL_DATA_DOCUMENT_HASH=7a4ac553b3b5f4f7fbaee6018215e87d1883598727cbd555123a2227c0fb48ea
PERSONAL_DATA_RETENTION_DRY_RUN=true
DADATA_API_KEY=

# The smoke test never touches object storage.
S3_ENDPOINT=https://s3.example.test
S3_REGION=ru-central1
S3_BUCKET=ci
S3_ACCESS_KEY_ID=ci
S3_SECRET_ACCESS_KEY=ci
S3_PUBLIC_URL=https://media.example.test
